<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Real pixels on high-DPI screens; otherwise Windows scales a blurry bitmap of the board. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>pawboard.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <!-- The window code assumes a 64-bit process (pointer-sized window data). -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Builds don't carry the folder they were built in (which includes the Windows user name). -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=Pawboard</PathMap>
  </PropertyGroup>

  <!-- Release builds ship without debug symbols, which would otherwise record local paths. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same paw for the tray and the window (the exe gets it from ApplicationIcon). -->
    <EmbeddedResource Include="pawboard.ico" LogicalName="pawboard.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

</Project>
